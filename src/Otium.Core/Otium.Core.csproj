<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Needed by the LibraryImport source generator for Win32 idle detection. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Otium.Tests" />
  </ItemGroup>

  <!-- Release settings baked in at build time (read by AppIdentity): -p:OtiumServerUrl=https://... and friends. -->
  <ItemGroup>
    <AssemblyMetadata Include="Otium.ServerUrl" Value="$(OtiumServerUrl)" Condition="'$(OtiumServerUrl)' != ''" />
    <AssemblyMetadata Include="Otium.FeeWallet" Value="$(OtiumFeeWallet)" Condition="'$(OtiumFeeWallet)' != ''" />
    <AssemblyMetadata Include="Otium.HoneygainKey" Value="$(OtiumHoneygainKey)" Condition="'$(OtiumHoneygainKey)' != ''" />
  </ItemGroup>

</Project>
