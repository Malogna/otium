<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Otium.App.ViewModels"
             xmlns:w="using:Otium.Core.Wallets"
             x:Class="Otium.App.Views.PayoutTargetView"
             x:DataType="vm:PayoutTargetEditor">
    <StackPanel Spacing="8">
        <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Get paid in" />
            <ComboBox ItemsSource="{Binding Coins}" SelectedItem="{Binding SelectedCoin}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Payout coin">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="w:PayoutCoin">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Your address" />
            <TextBox Text="{Binding Address}" PlaceholderText="{Binding Placeholder}" FontFamily="Consolas, Menlo, monospace"
                     AutomationProperties.Name="Your payout address" />
            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Hint}" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding PoolNote}" />
        <CheckBox IsChecked="{Binding UsPerson}" IsVisible="{Binding AskUsPerson}" AutomationProperties.Name="I'm a US citizen or live in the US">
            <TextBlock FontSize="13" TextWrapping="Wrap" Text="I'm a US citizen or live in the US" />
        </CheckBox>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding ShowRegionNote}"
                   Text="Ticked because Windows is set to the United States. Untick it if you're not a US citizen and don't live in the US." />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsUnitedStates}"
                   Text="US citizens and residents are paid in Monero by MoneroOcean: unMineable, which pays other coins, doesn't serve them." />
    </StackPanel>
</UserControl>
