<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Otium.App.ViewModels"
             xmlns:views="using:Otium.App.Views"
             x:Class="Otium.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,12,16,0">
            <Button Content="← Back" Command="{Binding BackCommand}" />
            <TextBlock Text="Advanced" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <TabControl Grid.Row="1" Padding="0" Margin="12,4,12,0">
            <TabItem Header="Details">
                <ScrollViewer>
                    <views:DashboardView DataContext="{Binding Dashboard}" Margin="4,8,4,24" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Invites">
                <ScrollViewer>
                    <views:InviteView DataContext="{Binding Invite}" Margin="4,8,4,24" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer>
                    <views:SettingsView DataContext="{Binding Settings}" Margin="4,8,4,24" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
