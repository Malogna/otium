<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Otium.App.ViewModels"
             xmlns:views="using:Otium.App.Views"
             x:Class="Otium.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <!-- Centred and no wider than its content, like the overview, so wide windows don't leave it hugging the left. -->
    <Grid RowDefinitions="Auto,*" MaxWidth="800">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="22,16,22,0">
            <Button AutomationProperties.Name="Back to overview" Command="{Binding BackCommand}" ToolTip.Tip="Back to overview">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconArrowLeft}" Width="16" Height="16" />
                    <TextBlock Text="Overview" />
                </StackPanel>
            </Button>
            <TextBlock Classes="h1" Text="Advanced" VerticalAlignment="Center" />
        </StackPanel>

        <TabControl Grid.Row="1" Padding="0" Margin="12,4,12,0">
            <TabItem Header="Details">
                <ScrollViewer>
                    <views:DashboardView DataContext="{Binding Dashboard}" Margin="4,8,4,24" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Invites">
                <ScrollViewer>
                    <views:InviteView DataContext="{Binding Invite}" Margin="4,8,4,24" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer>
                    <views:SettingsView DataContext="{Binding Settings}" Margin="4,8,4,24" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
