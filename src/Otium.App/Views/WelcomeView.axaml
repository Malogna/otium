<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Otium.App.ViewModels"
             xmlns:views="using:Otium.App.Views"
             x:Class="Otium.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

    <Grid RowDefinitions="*,Auto">
        <Carousel SelectedIndex="{Binding Step}">
            <Carousel.PageTransition>
                <PageSlide Duration="0:0:0.35" Orientation="Horizontal" SlideInEasing="CubicEaseOut" SlideOutEasing="CubicEaseIn" />
            </Carousel.PageTransition>

            <!-- ===== Step 1: what Otium is ===== -->
            <ScrollViewer>
                <StackPanel MaxWidth="520" Margin="24,48,24,24" Spacing="26" HorizontalAlignment="Center">
                    <Border Classes="rise" HorizontalAlignment="Center" CornerRadius="28" BoxShadow="0 16 40 0 #401DB97F">
                        <Image Source="/Assets/otium.png" Width="104" Height="104" />
                    </Border>
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h1" FontSize="36" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="Earn money while your computer rests" />
                        <TextBlock Classes="muted" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="Your processor and graphics card mine the best-paying coin while you're away, and the pool pays your own wallet. Set up and switched for you, close to one click." />
                    </StackPanel>

                    <Border Classes="card delay1" Padding="18">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="iconBadge"><Path Classes="icon" Data="{StaticResource IconMoon}" /></Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="Only while you're away" />
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="Touch the mouse and it steps aside. While it earns it keeps the computer awake (the screen still turns off), and it makes the computer warmer." />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="iconBadge"><Path Classes="icon" Data="{StaticResource IconLeaf}" /></Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="Watches the price of power" />
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="It pauses when electricity would likely cost more than it earns, based on your electricity price." />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="iconBadge"><Path Classes="icon" Data="{StaticResource IconWallet}" /></Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="Paid straight to your own wallet" />
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="The mining pool pays your address in the coin you choose, like USDT, BTC or LTC. Otium never holds your money." />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="error" HorizontalAlignment="Center" IsVisible="{Binding !IsSupported}"
                               Text="Sorry, Otium doesn't support this type of computer yet." />
                    <TextBlock Classes="error" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding UnavailableHere}"
                               IsVisible="{Binding UnavailableHere, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- Two ways in: everything on now, or step by step -->
                    <Grid ColumnDefinitions="*,14,*" IsEnabled="{Binding CanBegin}">
                        <Button Classes="choice accent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Command="{Binding QuickStartCommand}" AutomationProperties.Name="Quick start">
                            <StackPanel Spacing="4" Margin="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- Text on the accent green: white on the light theme's, near-black on the dark theme's brighter
                                         one (white there read at only 2.2:1). -->
                                    <Path Classes="icon filled" Data="{StaticResource IconPlay}" Width="14" Height="14"
                                          Stroke="{DynamicResource OnAccentText}" Fill="{DynamicResource OnAccentText}" />
                                    <TextBlock Text="Quick start" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource OnAccentText}" />
                                </StackPanel>
                                <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource OnAccentText}"
                                           Text="Processor and graphics card on, internet sharing one tick away. Just tell us where to pay you." />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="choice plain" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Command="{Binding CustomizeCommand}" AutomationProperties.Name="Customize">
                            <StackPanel Spacing="4" Margin="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon" Data="{StaticResource IconSliders}" Width="16" Height="16" />
                                    <TextBlock Text="Customize" FontWeight="Bold" FontSize="16" />
                                </StackPanel>
                                <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                                           Text="See what this PC could earn and choose each part yourself." />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <Button Classes="link" HorizontalAlignment="Center" AutomationProperties.Name="Sign in" Command="{Binding ToggleSignInCommand}">
                            <TextBlock Text="Already use Otium on another computer? Sign in" Foreground="{DynamicResource GoodBrush}" />
                        </Button>
                        <Border Classes="card" Width="380" IsVisible="{Binding ShowSignIn}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="Enter the email you use with Otium. Your balance and invite code come with you." />
                                <views:EmailSignInView DataContext="{Binding SignIn}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Step 2: what this PC could earn ===== -->
            <ScrollViewer>
                <StackPanel MaxWidth="560" Margin="24,40,24,24" Spacing="18" HorizontalAlignment="Center">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" Text="Here's what your PC could earn" />
                        <TextBlock Classes="good" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding SignedInText}"
                                   IsVisible="{Binding SignedInText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>

                    <Border Classes="hero">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Classes="heroMuted" HorizontalAlignment="Center" Text="Estimated for this computer" />
                            <TextBlock Classes="display" HorizontalAlignment="Center" Text="{Binding MonthlyEstimate}"
                                       IsVisible="{Binding !IsEstimating}" />
                            <ProgressBar IsIndeterminate="True" Width="160" Margin="0,24" IsVisible="{Binding IsEstimating}" Classes="goal onHero" />
                            <TextBlock Classes="heroMuted" FontSize="13" MaxWidth="440" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Text="{Binding EstimateDetail}" />
                            <TextBlock Classes="heroMuted" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="{Binding EstimateError}" IsVisible="{Binding EstimateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card delay1" Padding="18">
                        <StackPanel Spacing="12">
                            <ItemsControl ItemsSource="{Binding EstimateRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EstimateRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="iconBadge"><Path Classes="icon" Data="{Binding Icon}" /></Border>
                                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="muted" FontSize="12.5" Text="{Binding What}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PerDay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Background="{DynamicResource CardBorder}" Margin="0,2" />
                            <CheckBox IsChecked="{Binding UseCpu}">
                                <TextBlock Text="Use my processor" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsVisible="{Binding HasGpu}" IsChecked="{Binding UseGpu}">
                                <TextBlock Text="{Binding GpuName, StringFormat='Also use my {0}'}" TextWrapping="Wrap" />
                            </CheckBox>
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" FontSize="13" Text="Do you pay for this computer's electricity?" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton GroupName="power" IsChecked="{Binding PayForElectricity}" Content="Yes, count it" />
                                    <RadioButton GroupName="power" IsChecked="{Binding DontPayForElectricity}" Content="No, it's included or free" />
                                </StackPanel>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Path Classes="icon" Data="{StaticResource IconBolt}" Width="16" Height="16" />
                                <TextBlock Grid.Column="1" Classes="muted" FontSize="13" Margin="8,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ElectricityLine}" />
                                <Button Grid.Column="2" Classes="link" AutomationProperties.Name="Change electricity price" Command="{Binding EditPriceCommand}"
                                        IsVisible="{Binding PayForElectricity}">
                                    <TextBlock Text="Change" FontSize="13" Foreground="{DynamicResource GoodBrush}" />
                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditingPrice}">
                                <NumericUpDown Value="{Binding ElectricityPrice}" Minimum="0" Maximum="5" Increment="0.01" FormatString="0.000" Width="150" />
                                <TextBlock Classes="muted" VerticalAlignment="Center" Text="$ per kWh, from your power bill" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Estimates use today's payouts and typical speeds for your hardware. Real numbers appear within minutes of starting." />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Step 3: where to get paid ===== -->
            <ScrollViewer>
                <StackPanel MaxWidth="520" Margin="24,40,24,24" Spacing="18" HorizontalAlignment="Center">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" Text="Where should we pay you?" />
                        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Pick a coin and paste your own address for it. The pool pays it directly; Otium never touches the money." />
                    </StackPanel>
                    <Border Classes="card delay1" Padding="20">
                        <views:PayoutTargetView DataContext="{Binding Payout}" />
                    </Border>
                    <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="No wallet yet? Any wallet app or exchange account that can receive the coin works. You can change this later in Settings." />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Step 4: summary and start ===== -->
            <ScrollViewer>
                <StackPanel MaxWidth="520" Margin="24,40,24,24" Spacing="20" HorizontalAlignment="Center">
                    <TextBlock Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" Text="Ready when you are" />
                    <Border Classes="card delay1" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*">
                                <Path Classes="icon" Data="{StaticResource IconCheck}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap"
                                           Text="Otium starts with your computer and earns only after a few minutes without keyboard or mouse." />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Path Classes="icon" Data="{StaticResource IconCheck}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap"
                                           Text="It runs mining software (XMRig, and SRBMiner for graphics cards). Some antivirus tools flag these; Otium shows you how to allow them. If Windows Firewall asks to allow them, choose Cancel: they only need outgoing connections." />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Path Classes="icon" Data="{StaticResource IconCheck}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap" Text="{Binding PayoutLine}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Path Classes="icon" Data="{StaticResource IconCheck}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap" Text="{Binding FeeLine}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Path Classes="icon" Data="{StaticResource IconCheck}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap"
                                           Text="You can pause, change anything or uninstall at any time." />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Path Classes="icon" Data="{StaticResource IconCheck}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap"
                                           Text="Right after you start, Otium runs a two-minute test while you watch, so you see what this PC really earns. Your fans may speed up for those two minutes." />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Quick start: what's turned on, all of it, before Start -->
                    <Border Classes="card delay2" Padding="16" IsVisible="{Binding IsQuick}">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="Quick start turns on" />
                            <ItemsControl ItemsSource="{Binding QuickList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Path Classes="icon" Data="{StaticResource IconCheck}" VerticalAlignment="Top" Margin="0,2,0,0" Width="14" Height="14" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" Text="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Pressing Start earning means you agree to all of these. Turn any of them off in Settings at any time, or go Back and choose Customize." />
                            <CheckBox IsChecked="{Binding ShareInternet}" IsVisible="{Binding CanShareInternet}" Margin="0,6,0,0"
                                      AutomationProperties.Name="Also share my unused internet">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="Also share my unused internet" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{Binding SharingChoiceText}" />
                                </StackPanel>
                            </CheckBox>
                            <Button Classes="link" HorizontalAlignment="Left" IsVisible="{Binding CanShareInternet}" Command="{Binding OpenProxybaseTermsCommand}"
                                    AutomationProperties.Name="Read Proxybase's terms">
                                <TextBlock Text="Read Proxybase's terms" FontSize="12.5" Foreground="{DynamicResource GoodBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Customize: the choices, each with its own explanation -->
                    <Border Classes="card delay2" Padding="16" IsVisible="{Binding IsCustom}">
                        <StackPanel Spacing="14">
                            <CheckBox IsChecked="{Binding ShareInternet}" IsVisible="{Binding CanShareInternet}" AutomationProperties.Name="Share my unused internet too">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="Share my unused internet too" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{Binding SharingChoiceText}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding KeepMinerReady}" AutomationProperties.Name="Keep the processor miner ready when I come back">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="Keep the processor miner ready when I come back" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                                               Text="When you return, the miner pauses instead of closing, so it earns again the moment you step away. It stops using the processor at once, but keeps about 2.5 GB of memory reserved for up to 10 minutes." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Sharing earnings figures: consent, so a plain yes or no with nothing preselected (both setups) -->
                    <Border Classes="card delay2" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="Share analytics?" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Otium would send this PC's graphics card model, processor name, hours earning and amounts earned (and, if you share your internet, your country and what sharing earned), a few times a day. Never your address. otium.lol shows only figures combined across several PCs, so people can see what Otium really earns. You can change this in Settings at any time; saying no later deletes what was sent." />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Yes, share" Classes.accent="{Binding ShareEarningsYes}" Command="{Binding AnswerShareEarningsYesCommand}"
                                        AutomationProperties.Name="Yes, share my earnings figures" />
                                <Button Content="No thanks" Classes.accent="{Binding ShareEarningsNo}" Command="{Binding AnswerShareEarningsNoCommand}"
                                        AutomationProperties.Name="No, don't share my earnings figures" />
                            </StackPanel>
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding ShareEarningsUnanswered}"
                                       Text="Choose yes or no to start." />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <Button Classes="link" HorizontalAlignment="Center" AutomationProperties.Name="Have an invite code?" Command="{Binding ToggleInviteCommand}">
                            <TextBlock Text="Have an invite code?" Foreground="{DynamicResource GoodBrush}" />
                        </Button>
                        <StackPanel Spacing="4" IsVisible="{Binding ShowInvite}" HorizontalAlignment="Center">
                            <TextBox Text="{Binding InviteCode}" PlaceholderText="e.g. 7KQ2M9X" Width="220"
                                     HorizontalContentAlignment="Center" FontFamily="Consolas, Menlo, monospace" />
                            <TextBlock Classes="error" HorizontalAlignment="Center" Text="{Binding InviteError}"
                                       IsVisible="{Binding InviteError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Classes="good" FontSize="12" HorizontalAlignment="Center" IsVisible="{Binding InviteFromLink}"
                                       Text="Filled in from your friend's invite link." />
                            <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Center" Text="Your first 30 days are fee-free." />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding IsSimulated}"
                               Text="Dev mode: simulated processor and graphics card, simulated pool, fake payouts." />
                </StackPanel>
            </ScrollViewer>
        </Carousel>

        <!-- ===== Footer: progress dots and navigation ===== -->
        <StackPanel Grid.Row="1">
        <!-- The last question sits at the bottom of a long page: say why Start earning is waiting. -->
        <TextBlock Classes="muted" FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="28,8,28,0" MaxWidth="560" Text="Answer &quot;Share analytics?&quot; at the bottom of this page to start.">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsStep3" />
                    <Binding Path="ShareEarningsUnanswered" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <Grid ColumnDefinitions="*,Auto,*" Margin="28,8,28,28" MaxWidth="560">
            <Button Classes="link" HorizontalAlignment="Left" IsVisible="{Binding !IsStep0}" AutomationProperties.Name="Back" Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Data="{StaticResource IconArrowLeft}" Width="16" Height="16" Stroke="{DynamicResource MutedText}" />
                    <TextBlock Text="Back" Foreground="{DynamicResource MutedText}" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Classes="stepDot" Classes.active="{Binding IsStep0}" />
                <Border Classes="stepDot" Classes.active="{Binding IsStep1}" />
                <Border Classes="stepDot" Classes.active="{Binding IsStep2}" />
                <Border Classes="stepDot" Classes.active="{Binding IsStep3}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="accent big" HorizontalAlignment="Right" IsVisible="{Binding ShowNext}" AutomationProperties.Name="Next" Command="{Binding NextCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Next" />
                    <Path Classes="icon" Data="{StaticResource IconArrowRight}" Width="16" Height="16" Stroke="White" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="accent big" HorizontalAlignment="Right" IsVisible="{Binding IsStep3}" AutomationProperties.Name="Start earning" Command="{Binding StartCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon filled" Data="{StaticResource IconPlay}" Width="14" Height="14" Stroke="White" Fill="White" />
                    <TextBlock Text="Start earning" />
                </StackPanel>
            </Button>
        </Grid>
        </StackPanel>
    </Grid>
</UserControl>
