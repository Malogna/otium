<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Otium.App.ViewModels"
             x:Class="Otium.App.Views.InternetSharingConsentView"
             x:DataType="vm:InternetSharingViewModel">

    <!-- What the user agrees to before internet sharing can run. Same text on the overview and in Advanced. -->
    <StackPanel Spacing="12">
        <Border Classes="tile">
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="How it works" />
                <TextBlock TextWrapping="Wrap" FontSize="13" Text="{Binding ConsentText}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12.5" Text="{Binding LimitsText}" />
                <Button Classes="link" HorizontalAlignment="Left" IsVisible="{Binding IsMysterium}" Command="{Binding OpenMysteriumTermsCommand}"
                        AutomationProperties.Name="Read Mysterium's terms">
                    <TextBlock Text="Read Mysterium's terms" FontSize="12.5" Foreground="{DynamicResource GoodBrush}" />
                </Button>
            </StackPanel>
        </Border>
        <StackPanel Spacing="4" IsVisible="{Binding NeedsPolygonAddress}">
            <TextBlock Classes="label" Text="Your Polygon address for MYST" />
            <TextBox Text="{Binding PolygonAddress}" PlaceholderText="0x…" FontFamily="Consolas, Menlo, monospace"
                     AutomationProperties.Name="Your Polygon address" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Your payout address isn't on Polygon, so Mysterium needs one: any 0x address from a wallet that supports Polygon (MetaMask, Trust Wallet, an exchange's Polygon deposit address for MYST)." />
            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding PolygonError}"
                       IsVisible="{Binding PolygonError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="accent" Content="I agree, turn it on" Command="{Binding AgreeCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="Not now" Command="{Binding NotNowCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
