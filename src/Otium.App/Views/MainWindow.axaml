<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Otium.App.ViewModels"
        xmlns:controls="using:Otium.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
        x:Class="Otium.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/otium.ico"
        Width="1100" Height="780" CanResize="False" CanMaximize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}"
        TextElement.Foreground="{DynamicResource Ink}"
        Classes.intro="{Binding IsIntro}"
        Title="Otium">

    <Grid>
        <!-- The night sky behind every screen; its emerald glow brightens while Otium earns. -->
        <controls:NightBackdrop Intensity="{Binding EarningGlow}" />

        <!-- Going deeper (Overview → Advanced) slides in from the right, going back from the left. Both screens are kept alive, so
             going back shows the Overview as it was instead of building it again. -->
        <controls:PageStack Content="{Binding CurrentPage}" IsReversed="{Binding IsGoingBack}" />
    </Grid>

</Window>
