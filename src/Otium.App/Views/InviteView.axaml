<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Otium.App.ViewModels"
             xmlns:accounts="using:Otium.Core.Accounts"
             x:Class="Otium.App.Views.InviteView"
             x:DataType="vm:InviteViewModel">

    <UserControl.Styles>
        <Style Selector="Border.leader">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Border.leader.you">
            <Setter Property="Background" Value="{DynamicResource GoodSoft}" />
        </Style>
        <Style Selector="Border.leader.you TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.styles">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.styles ListBoxItem">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
        <Border Classes="card">
            <StackPanel Spacing="14">
                <TextBlock Classes="h1" Text="Invite friends, mine fee-free" />

                <TextBlock Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="error" Text="{Binding CodeErrorText}" IsVisible="{Binding CodeErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <StackPanel Spacing="10" IsVisible="{Binding HasCode}">
                    <TextBlock Classes="label" Text="Your invite code" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{DynamicResource NeutralSoft}" CornerRadius="10" Padding="18,8">
                            <SelectableTextBlock Text="{Binding Code}" FontSize="30" FontWeight="Bold" LetterSpacing="4"
                                                 FontFamily="Consolas, Menlo, monospace" />
                        </Border>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <Button Content="Copy code" Command="{Binding CopyCodeCommand}" />
                            <Button Content="Copy link" Command="{Binding CopyLinkCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <SelectableTextBlock Classes="muted" Text="{Binding ShareUrl}" FontFamily="Consolas, Menlo, monospace" />

                    <TextBlock Classes="label" Margin="0,8,0,0" Text="Pick a message, or write your own" />
                    <ListBox Classes="styles" ItemsSource="{Binding ShareStyles}" SelectedItem="{Binding SelectedStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="accounts:ShareStyle">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox Text="{Binding Message}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                             AutomationProperties.Name="Invite message" />

                    <TextBlock Classes="label" Margin="0,4,0,0" Text="Send it" />
                    <WrapPanel>
                        <Button Classes="accent" Margin="0,0,8,8" Content="WhatsApp" Command="{Binding ShareWhatsAppCommand}"
                                ToolTip.Tip="Opens WhatsApp with the message ready to send" />
                        <Button Classes="accent" Margin="0,0,8,8" Content="Discord" Command="{Binding ShareDiscordCommand}"
                                ToolTip.Tip="Copies the message formatted for Discord; paste it into a chat or server" />
                        <Button Classes="accent" Margin="0,0,8,8" Content="Email" Command="{Binding ShareEmailCommand}"
                                ToolTip.Tip="Opens your email app with the invite written" />
                        <Button Margin="0,0,8,8" Content="Copy message" Command="{Binding CopyMessageCommand}" />
                        <Button Margin="0,0,8,8" Content="X" Command="{Binding ShareXCommand}" />
                        <Button Margin="0,0,8,8" Content="Reddit" Command="{Binding ShareRedditCommand}" />
                    </WrapPanel>
                    <TextBlock Classes="good" FontSize="13" Text="{Binding CopiedText}" />
                </StackPanel>

                <TextBlock Classes="muted" IsVisible="{Binding !HasCode}"
                           Text="Your invite code appears here once Otium has connected to the invite server." />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="How rewards work" />
                <TextBlock TextWrapping="Wrap" Text="{Binding RewardFriend, StringFormat='• {0}'}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding RewardYou, StringFormat='• {0}'}" />
                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{Binding RewardBonus}" />
                <TextBlock Classes="muted" FontSize="13"
                           Text="Rewards come only out of Otium' own fee, so your friends never earn less because you invited them. Rewards are paid by the pool to your wallet; Otium never holds anyone's money." />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Your invites" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Classes="muted" Text="Friends who joined" />
                    <TextBlock Grid.Column="1" Text="{Binding InvitedCount}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Classes="muted" Text="Friends who started mining" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VerifiedCount}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Classes="muted" Text="Earned from friends"
                               ToolTip.Tip="Estimated by your friends' apps. It's mined straight to your address, so it's already in your pool balance." />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EarnedFromFriends}" FontWeight="SemiBold" Classes="good" />
                </Grid>
                <TextBlock Classes="good" Text="{Binding FeeFreeText}"
                           IsVisible="{Binding FeeFreeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="muted" Text="{Binding ReferredByText}"
                           IsVisible="{Binding ReferredByText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsRefreshing}" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Classes="h2" Text="{Binding LeaderboardTitle}" />
                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                               Text="Ranked by friends who joined this month and started earning. Others appear by the start of their invite code." />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Leaders}" IsVisible="{Binding HasLeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LeaderRow">
                            <Border Classes="leader" Classes.you="{Binding IsYou}">
                                <Grid ColumnDefinitions="44,*,Auto">
                                    <TextBlock Classes="muted" Text="{Binding Rank}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Consolas, Menlo, monospace" />
                                    <TextBlock Grid.Column="2" Text="{Binding Friends}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock TextWrapping="Wrap" Text="{Binding LeaderboardNote}"
                           IsVisible="{Binding LeaderboardNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
