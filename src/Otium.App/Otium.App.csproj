<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Otium</AssemblyName>
    <RootNamespace>Otium.App</RootNamespace>
    <ApplicationIcon>Assets\otium.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Otium.Core\Otium.Core.csproj" />
    <ProjectReference Include="..\Otium.Providers.XMRig\Otium.Providers.XMRig.csproj" />
    <ProjectReference Include="..\Otium.Providers.SrbMiner\Otium.Providers.SrbMiner.csproj" />
    <ProjectReference Include="..\Otium.Providers.Honeygain\Otium.Providers.Honeygain.csproj" />
    <ProjectReference Include="..\Otium.Providers.Mysterium\Otium.Providers.Mysterium.csproj" />
  </ItemGroup>
</Project>
