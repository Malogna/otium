# Off-site backup credentials for the backup container only (the server never sees them). Copy to backup.env, then
# set BACKUP_RCLONE_REMOTE in .env to "<remote>:<bucket or path>". rclone reads remotes from RCLONE_CONFIG_<NAME>_*
# variables; see https://rclone.org/docs/#config-file and the page for your storage provider.
#
# Give these credentials write access only (no delete) where the provider allows it, and let lifecycle rules expire
# old copies, so a compromised server can't erase its own backups.

# Example: an S3-compatible bucket as remote "offsite" (BACKUP_RCLONE_REMOTE=offsite:otium-backups).
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# Example: another machine over SFTP as remote "offsite" (BACKUP_RCLONE_REMOTE=offsite:/srv/otium-backups).
# RCLONE_CONFIG_OFFSITE_TYPE=sftp
# RCLONE_CONFIG_OFFSITE_HOST=backup.example.com
# RCLONE_CONFIG_OFFSITE_USER=otium
# The private key, with its line breaks written as \n:
# RCLONE_CONFIG_OFFSITE_KEY_PEM=
