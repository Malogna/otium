# HTTPS in front of the Otium server when its DNS name is proxied by Cloudflare (orange cloud). Select it with
# CADDYFILE=Caddyfile.cloudflare in .env, and set Cloudflare's SSL/TLS mode to "Full (strict)".
#
# Caddy still gets its own Let's Encrypt certificate: Cloudflare passes /.well-known/acme-challenge/ through to port 80
# even with "Always Use HTTPS" on. Visitors reach Caddy through Cloudflare, so the visitor's own address comes from
# Cloudflare's CF-Connecting-IP header, trusted only from Cloudflare's published ranges (https://www.cloudflare.com/ips/,
# October 2026; update them if Cloudflare adds any). Anyone reaching the server directly is seen as themselves. Caddy
# passes that one address on as X-Forwarded-For, which the server needs for per-IP limits.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$OTIUM_DOMAIN} {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000"

	# Development-only endpoints never belong on the public server, even if DevMode is switched on by mistake.
	respond /dev/* 404

	reverse_proxy otium:8080 {
		# The visitor's address as worked out above, replacing Cloudflare's own X-Forwarded-For chain.
		header_up X-Forwarded-For {client_ip}
	}
}

# www.<domain> (also proxied by Cloudflare) goes to the bare domain.
www.{$OTIUM_DOMAIN} {
	redir https://{$OTIUM_DOMAIN}{uri} permanent
}
