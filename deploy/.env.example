# Otium server settings for docker compose. Copy to .env (never commit it) and fill it in; see docs/deploying.md.
#
# Every line is NAME=value. Nested settings use "__" where appsettings.json nests (Earnings:PoolWallets:0 ->
# Earnings__PoolWallets__0). Commented-out lines show the built-in default; leave them commented unless you need to
# change them, because an empty value is not the same as unset. Wrap values containing "$" in single quotes.
# After editing, apply with: docker compose up -d

# ---------- Deployment (read by docker-compose.yml) ----------

# Public host name; its DNS A record must point at this machine before the first start.
OTIUM_DOMAIN=otium.example.com
# Let's Encrypt account email (expiry and problem notices).
ACME_EMAIL=ops@example.com

# Hours between database backups, and how many days of local backups to keep.
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP_DAYS=14
# Optional off-site copies through rclone, e.g. offsite:otium-backups. Define the remote in backup.env (see
# backup.env.example). Empty = local backups only.
BACKUP_RCLONE_REMOTE=
# Optional: delete off-site copies older than this many days. Empty = keep them (prefer bucket lifecycle rules).
BACKUP_RCLONE_KEEP_DAYS=

# docker-compose.yml also sets ReverseProxy__Enabled=true and ReverseProxy__KnownProxies__0 (Caddy's address) for
# the server; they belong to the compose network layout, so they're not set here.

# ---------- Database ----------

# SQLite database on the otium-data volume. The image already defaults to this; change it only to move the file.
ConnectionStrings__Otium=Data Source=/data/otium.db

# ---------- Admin ----------

# Enables /admin and the /admin/* API (sent as the X-Admin-Token header). Generate with: openssl rand -hex 32
# Empty = admin endpoints disabled.
Admin__Token=

# ---------- Public links ----------

# Base URL in invite links. Set it to https://<OTIUM_DOMAIN>.
Referral__PublicBaseUrl=https://otium.example.com
# Where the invite landing page sends people to download the app.
# Referral__DownloadUrl=https://github.com/Malogna/otium/releases/latest

# ---------- Custody ----------

# Off (the default), Otium is non-custodial: pools pay users' own addresses, and the server keeps accounts and
# referrals only. Everything below about earnings, cash-outs, the treasury and bandwidth applies only with it on.
# Custody__Enabled=false
# Otium's own fee address on unMineable, for the admin dashboard's fee and referral earnings.
# Unmineable__OtiumTarget=USDT:T...

# ---------- Earnings (balance accounts mining to the operator; Custody__Enabled=true only) ----------

# Operator XMR addresses that balance accounts mine to (subaddresses of one wallet). Uncomment and add __1, __2, ...
# for more; don't leave one empty. Balance mode stays off until one is set or the Monero wallet RPC below is configured.
# Earnings__PoolWallets__0=8...
# Otium's fee, the referrer's share (paid out of the fee) and how long credits are held before cash-out.
# Earnings__FeePercent=10
# Earnings__ReferralPercent=5
# Earnings__HoldPeriod=2.00:00:00
# Accounts per pool address (MoneroOcean tells ~50 active workers apart per address).
# Earnings__MaxAccountsPerPoolWallet=40

# ---------- Cash-outs (crypto: BTC directly, ETH/BNB/SOL swapped through THORChain) ----------

# Methods offered, in order (default btc, eth, bnb, sol). Add paypal or xmr only to re-enable those older methods.
# Cashouts__Methods__0=btc
# Minimum cash-out per method, in USD (defaults: btc 5, bnb 5, eth 8, sol 8).
# Cashouts__MinUsd__eth=8
# Cash-outs up to this amount are sent automatically when the other checks pass; larger ones wait for review.
# Cashouts__AutoApproveMaxUsd=50
# Total automatic payouts per 24 hours across all users; beyond it requests wait for review.
# Cashouts__DailyAutoBudgetUsd=1000
# Accounts younger than this are reviewed on their first cash-out.
# Cashouts__MinAccountAgeForAuto=2.00:00:00

# ---------- Bitcoin treasury (pays every crypto cash-out) ----------

# bitcoind's JSON-RPC (pruned is fine), on a private network only (never exposed to the internet); see
# docs/deploying.md. Empty = crypto cash-outs wait in the review queue to be paid by hand.
BitcoinWallet__RpcUrl=
BitcoinWallet__Username=
BitcoinWallet__Password=
# The wallet name (bitcoind -rpcwallet), e.g. otium-payouts.
BitcoinWallet__Wallet=
# Fee target in blocks for payouts (6 is about an hour).
# BitcoinWallet__ConfTarget=6

# THORNode API for prices, swap quotes and status (no key needed).
# Thorchain__ApiBase=https://gateway.liquify.com/chain/thorchain_api/

# OFAC sanctioned-address lists are downloaded from GitHub every 12 hours; override a list's URL only if needed.
# Sanctions__RefreshInterval=12:00:00

# ---------- Monero wallet (pool addresses) ----------

# monero-wallet-rpc started with --rpc-login, on a private network only. Used to create MoneroOcean pool
# subaddresses for balance accounts (and Monero cash-outs only if xmr is re-enabled above). Optional.
MoneroWallet__RpcUrl=
MoneroWallet__Username=
MoneroWallet__Password=

# ---------- PayPal Payouts (off unless Cashouts__Methods includes paypal) ----------

# PayPal__ClientId=
# PayPal__ClientSecret=
# PayPal__UseSandbox=true

# ---------- Email (sign-in codes and receipts) ----------

# Any SMTP service (Postmark, SES, Mailgun, ...). Empty host = emails aren't sent, so email sign-in won't work.
Email__SmtpHost=
Email__Port=587
Email__Username=
Email__Password=
Email__From="Otium <no-reply@otium.example.com>"
# Email__EnableSsl=true

# ---------- Kryptex Pool (GPU coins, and Monero for CPUs routed there) ----------

# Off by default. When enabled, set up auto-exchange to BTC on the operator's Kryptex account.
Kryptex__Enabled=false
# The operator's Kryptex account name (miners log in as Account.worker).
# Kryptex__Account=
# Per-algorithm coin overrides (defaults exist for pearlhash and quantus), e.g.:
# Kryptex__Coins__pearlhash__Coin=prl
# Kryptex__Coins__pearlhash__WhatToMineId=469
# Kryptex__Coins__pearlhash__Host=prl.kryptex.network
# Kryptex__Coins__pearlhash__Port=7048
# Kryptex's Monero pool for CPUs (TLS port 8029).
# Kryptex__Cpu__Host=xmr.kryptex.network
# Kryptex__Cpu__Port=8029
# Share of balance accounts (0-100) whose CPU mines Monero on Kryptex instead of MoneroOcean. Start small.
# CpuMining__KryptexPercent=0

# ---------- GPU policy ----------

# Kill switch: algorithms disabled for every app at the next refresh (add __1, __2, ... for more).
# GpuPolicy__Disabled__0=
# Tier override per algorithm: primary, free-power-only or disabled.
# GpuPolicy__Tiers__kawpow=disabled
# GpuPolicy__RefreshInterval=00:10:00

# ---------- Internet sharing (bandwidth) ----------

# Off by default; turn on once the partner agreement is signed.
Bandwidth__Enabled=false
# Shown to users on the consent screen.
# Bandwidth__PartnerName=Honeygain
# Gross rates credited from usage reports, before the fee. Set them from the partner agreement.
# Bandwidth__UsdPerSharingHour=0.0006
# Bandwidth__UsdPerGb=0
# Limits on self-reported usage: daily cap per computer, speed cap, longest report, and how long before another
# computer on the same connection can take over as the paid sharer.
# Bandwidth__DailyLimitBytes=10737418240
# Bandwidth__MaxBytesPerSecond=2097152
# Bandwidth__MaxReportPeriod=00:15:00
# Bandwidth__SharedConnectionWindow=00:15:00

# ---------- Never in production ----------

# DevMode__Enabled and DevMode__FakePayouts are for local development only (fake payouts, /dev/outbox). Leave unset.
