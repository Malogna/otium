<Project Sdk="Microsoft.NET.Sdk">

  <!-- Signs a release's update feeds on the developer's own computer (see Otium.Core.Updates.UpdateSignature), so the
       signing key never goes to GitHub or Otium's server. Usage: docs/release-candidate.md, "Signing a release". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Otium.Core\Otium.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows DPAPI: the signing key file only opens for the Windows account that made it. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
