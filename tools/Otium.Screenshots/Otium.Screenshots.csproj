<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the app's screens off-screen (Avalonia headless + Skia) into PNGs, for checking layouts without opening
       a window. Uses a temporary data folder and simulated miners, so a real Otium install is never touched. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Otium.App\Otium.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

</Project>
